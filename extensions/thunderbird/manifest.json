{
  "manifest_version": 2,
  "name": "GWyl Mail — vérifier",
  "version": "0.3.1",
  "description": "Vérifie le message affiché auprès de l'interface locale GWyl Mail.",
  "browser_specific_settings": {
    "gecko": {
      "id": "gwyl-verify@gwyl.mail",
      "strict_min_version": "115.0"
    }
  },
  "permissions": ["messagesRead", "http://127.0.0.1:8765/*"],
  "message_display_action": {
    "default_title": "Vérifier GWyl",
    "default_popup": "popup.html"
  }
}
