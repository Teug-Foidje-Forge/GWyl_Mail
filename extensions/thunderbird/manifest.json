{
  "manifest_version": 2,
  "name": "GWyl Mail",
  "version": "0.4.0",
  "description": "Au moment d'envoyer, confie le message à l'application locale. Thunderbird n'envoie pas une deuxième copie.",
  "browser_specific_settings": {
    "gecko": {
      "id": "gwyl-verify@gwyl.mail",
      "strict_min_version": "115.0"
    }
  },
  "permissions": [
    "compose",
    "messagesRead",
    "notifications",
    "http://127.0.0.1:8765/*"
  ],
  "background": {
    "scripts": ["background.js"]
  },
  "message_display_action": {
    "default_title": "Vérifier GWyl",
    "default_popup": "popup.html"
  }
}
